# Copy this file to .env and fill in your values:  cp .env.example .env
# .env is git-ignored, so your key is never committed.

# Required for the Claude-based agents (simulate, compare-models)
ANTHROPIC_API_KEY=your_key_here

# Optional: only needed if your Anthropic organisation uses workspaces
# ANTHROPIC_WORKSPACE_ID=your_workspace_id
